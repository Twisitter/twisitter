# Store publishing (yarn publish:all, publish:chrome, publish:firefox). Copy to
# .env, which git ignores, and fill in. Nothing else reads it.

# Chrome Web Store: the item's id from its dashboard URL, an OAuth client of the
# Google account that owns the listing (Google Cloud Console, with the Chrome Web
# Store API on), and a refresh token, which `yarn refresh:chrome` mints and
# writes here.
CHROME_EXTENSION_ID=
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=
# Optional: the publisher id in dashboard URLs, for the edit link it opens.
CHROME_DASHBOARD_ID=
# OAUTH_PORT=3000

# Firefox Add-ons: API credentials from
# https://addons.mozilla.org/developers/addon/api/key/ (per account). The add-on
# id is read from the built manifest; set FIREFOX_EXTENSION_ID only to override it.
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=
# FIREFOX_EXTENSION_ID=
